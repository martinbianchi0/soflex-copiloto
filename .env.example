# Copiar a `.env` para cambiar la configuración. `.env` no se versiona.
# Sin `.env`, el servicio levanta igual, en modo `mock`.

# Quién interpreta la llamada.
#   mock:   reglas, determinístico y sin red.
#   ollama: un modelo local servido por Ollama; si no responde, siguen las reglas. El panel
#           deja elegir, para cada llamada, entre el modelo y las reglas.
LLM_PROVIDER=mock

# Sólo para `ollama`. El modelo se baja antes: `ollama pull qwen3.5:4b-q4_K_M`.
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
# Dónde está Ollama. Por defecto, el de la misma máquina: desde Docker es
# http://host.docker.internal:11434 y fuera de Docker, http://localhost:11434.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Segundos que tiene el modelo para todo el análisis de una llamada (todos sus pedidos y
# reintentos). Después siguen las reglas.
LLM_TIMEOUT_S=60

# Trazas de las llamadas en un Langfuse propio. Se activan con las dos claves.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Desde Docker es http://host.docker.internal:3000 y fuera de Docker, http://localhost:3000.
# LANGFUSE_BASE_URL=http://host.docker.internal:3000
